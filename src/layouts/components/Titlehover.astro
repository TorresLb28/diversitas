
---
interface Props {
    title?: string;
}

const { title } = Astro.props;
---

<h1 class="title-hover" style="text-align: center; margin-top: 25px">{title ? title : <slot/>}</h1>

<style>
    .title-hover {
      transition: transform 0.3s ease; /* Suaviza la transformación */
    }
    
    .title-hover:hover {
      transform: scale(1.1); /* Aumenta el tamaño al 110% */
    }
  </style>