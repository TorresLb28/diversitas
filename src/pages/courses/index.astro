---
import { Image } from "astro:assets";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import Post from "@/layouts/partials/Post.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import { getEntryBySlug } from "astro:content";
import type { TIndexData } from "@/types";
import Titlehover from "@/components/Titlehover.astro";

const { blog_folder, summary_length } = config.settings;

const postIndex = (await getEntryBySlug<any, string>(
  blog_folder,
  "index",
)) as TIndexData;
const posts = await getSinglePage(blog_folder as any);
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);
---

<Base title={postIndex?.data.title}>

  <section class="section" style="background-color: #EDF6F5">
    <div class="container">
      <h1 style="text-align: center; margin-top: 25px; margin-bottom: 10px;">Cursos Online</h1>
      <div class="row pb-12">
        <div class="row col-12 pb-24 pt-16" >
          <div class="image md:col-6">
            {currentPosts[0].data.image && (
              <Image
                style="box-shadow: 0 6px 12px rgba(0, 0, 0, 0.92);"
                class="rounded-lg"
                src="/images/diverCursos.jpg"
                alt="imagen Cursos Online"
                width={525}
                height={275}
              />
            )}
          </div>
          <div class="md:col-6">
            <h2 class="h3 mb-2 mt-4; little-hover">
              <a
                href=/courses/onlinecourses
                class="block hover:text-primary"
              >
                Cursos de lenguas extranjeras:
              </a>
            </h2>
            <p style="text-align: justify; font-size: 1.2em; font-weight: bold;">
              Cada uno de nuestros cursos está diseñado para ofrecer una experiencia de aprendizaje enriquecedora, combinando teoría con prácticas interactivas y casos reales. Nuestro objetivo es que no solo adquieras nuevos conocimientos, sino que también desarrolles una apreciación profunda por la diversidad que nos rodea.
            </p>
            <br />
            <p style="text-align: justify; font-size: 1.2em;">
              ¡Únete a nosotros en Diversitas y da el primer paso hacia un mundo más diverso, inclusivo y conectado!
            </p>
            <a
              class="btn btn-primary mt-4"
              href=/courses/onlinecourses
              rel=""
            >
              Saber Más
            </a>
          </div>
        </div>
  </section>

        <!-- Esta parte es la primera versión de los cursos en el extrangero
         //no borrar para tenerlo por si acaso en futuras cosas
        <h1 id="cursoextra"></h1>
        <h1 style="text-align: center; margin-top: 100px; margin-bottom: 50px;">
          Cursos en el Extranjero
        </h1>
        {currentPosts.slice(1).map((post) => (
          <div class="col-12 mb-8 sm:col-6 lg:col-4">
            <Post post={post} />
          </div>
        ))}-->
      <section class="section" id="cursoextra">
            <div class="container" >
            <h1 ></h1>
            <h1 style="text-align: center; margin-top: 10px; margin-bottom: 30px;">
              <img src="/images/new.png" alt="Icono de Nuevo" class="animar-icono" style="width: 60px; vertical-align: middle; margin-right: 10px; position: relative; top: 35px;">
              Cursos en el Extranjero
            </h1>
            <p class="txt" style="text-align: center; font-size: 1.6em; font-weight: bold; margin-top: 5px; color: #0DA697;">
              Verano 2025, ¡Aprovecha y haz pagos parciales desde noviembre o desde que te inscribas!
          </p>
            <br>
            <br>
            <!--Curso de Francés en Francia -->
            <div class="row pb-12">
              <div class="col-12 mb-8 sm:col-6 lg:col-4">
                <div class="text-center">
                  <a href="/soon">
                  <Image
                    style="box-shadow: 0 6px 12px rgba(0, 0, 0, 0.92);"
                    class="image rounded-lg"
                    src="/images/fr1.png"
                    alt="Imagen Curso Francés Francia"
                    width={320}
                    height={300}
                  />
                  </a>
                  <a href="/soon"><h3 class="h4 mb-2 mt-4 little-hover">Curso de Francés en Francia</h3></a>
                  <p style="text-align: justify; font-size: 1.1em;">
                    Aprende francés desde cero y sumérgete en una cultura fascinante con hablantes nativos.
                  </p>
                  <a
                    class="btn btn-primary mt-4"
                    href="/soon"
                    rel=""
                  >
                    Saber Más
                  </a>
                </div>
              </div>

            <!--Curso de Alemán en Alemania -->
              <div class="col-12 mb-8 sm:col-6 lg:col-4">
                <div class="text-center">
                  <a href="/courses/excourses/deuex">
                  <Image
                    style="box-shadow: 0 6px 12px rgba(0, 0, 0, 0.92);"
                    class="image rounded-lg"
                    src="/images/deu1.png"
                    alt="Imagen Curso Alemán Alemania"
                    width={320}
                    height={300}
                  />
                  </a>
                  <a href="/courses/excourses/deuex"><h3 class="h4 mb-2 mt-4 little-hover">Curso de Alemán en Alemania</h3></a>
                  <p style="text-align: justify; font-size: 1.1em;">
                    Domina el alemán con nuestro curso intensivo y mejora tus oportunidades laborales.
                  </p>
                  <a
                    class="btn btn-primary mt-4"
                    href="/courses/excourses/deuex"
                    rel=""
                  >
                    Saber Más
                  </a>
                </div>
              </div>
            <!--Curso de Italiano en Italia -->
              <div class="col-12 mb-8 sm:col-6 lg:col-4">
                <div class="text-center">
                  <a href="/courses/excourses/itaex">
                  <Image
                    style="box-shadow: 0 6px 12px rgba(0, 0, 0, 0.92);"
                    class="image rounded-lg"
                    src="/images/pr1.png"
                    alt="Imagen Curso Italiano Italia"
                    width={320}
                    height={300}
                  />
                 </a>
                  <a href="/courses/excourses/itaex"><h3 class="h4 mb-2 mt-4 little-hover" >Curso de Italiano en Italia</h3></a>
                  <p style="text-align: justify; font-size: 1.1em;">
                    Adéntrate en el idioma Italiano y su cultura milenaria con este curso introductorio.
                  </p>
                  <a
                    class="btn btn-primary mt-4"
                    href="/courses/excourses/itaex"
                    rel=""
                  >
                    Saber Más
                  </a>
                </div>
              </div>
            </div>    
            </div>
            <!--Esta parte es para que puedas cambiar de página en un futuro para que sea de noticias-->
            <!--
            <Pagination
              section={blog_folder}
              currentPage={1}
              totalPages={totalPages}
            />
            -->
          </div>
        </section>

        <style>
    /*************************************************************/
    /* Animación de Texto Verano */
    /*************************************************************/
          .txt {
              display: inline-block; /* Asegura que el elemento se mantenga centrado */
              animation: agrandarReducir2 2s infinite;
          }

          @keyframes agrandarReducir2 {
              0%, 100% {
                  transform: scale(1); /* Tamaño original */
              }
              50% {
                  transform: scale(1.1); /* Aumenta ligeramente el tamaño */
              }
          }
    /*************************************************************/
    /* Animación de New */
    /*************************************************************/
          @keyframes agrandarReducir {
            0% {
              transform: scale(1);
            }
            50% {
              transform: scale(1.5);
            }
            100% {
              transform: scale(1);
            }
          }
        
          .animar-icono {
            width: 30px;
            animation: agrandarReducir 2s infinite;
          }

    /*************************************************************/
    /* Animación de titulos pequeños*/
    /*************************************************************/
    .little-hover {
            transition: transform 0.3s ease; /* Suaviza la transformación */
          }
          
          .little-hover:hover {
            transform: scale(1.02); /* Aumenta el tamaño al 110% */
          }
          a:hover .little-hover {
        color: #0DA697; /* Cambia el color al pasar el mouse */
          }

    /*************************************************************/
    /* Animación de imagenes */
    /*************************************************************/
    .image {
        transition: transform 0.3s ease; /* Suaviza la transformación */
      }
      
      .image:hover {
        transform: scale(1.02); /* Aumenta el tamaño al 110% al pasar el mouse */
      }
        </style>

</Base>

