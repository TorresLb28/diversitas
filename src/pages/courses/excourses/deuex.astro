---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import { getEntryBySlug } from "astro:content";

const homepage = await getEntryBySlug("homepage", "index");
const { banner, feature, services, workflow, call_to_action } = homepage.data;
---
<Base title="Curso Alemán">
      <!-- Título inicial -->
  <section class="section">
    <div class="container">
      <h1 style="text-align: center; margin-top: 25px; margin-bottom: 10px;" class="title-hover">Curso de Alemán en Alemania</h1>
    </div>
  </section>

      <!-- Sección de Fechas disponibles -->
  <section class="section" style="background-color: #FFFFFF; padding-top: 20px;">
    <div class="container">
      <div class="items-center gap-8 md:grid md:grid-cols-2">
        <!-- Contenido de texto a la izquierda -->
        <div class="content">
          <h2 class="title-hover" style="text-align: center;">Curso de Alemán en Alemania  Fechas disponibles:</h2>
          <ul style="list-style: none; padding: 0; font-size: 1.3em; text-align: justify;">
            <li class="title-hover"><a href="#FraJune">Junio 2025</a></li>
            <li class="title-hover"><a href="#FraJuly">Julio 2025</a></li>
            <li class="title-hover"><a href="#FraAug">Agosto 2025</a></li>
            <li><b><i>¡Escoge la fecha que mejor se adapte a tu agenda y prepárate para una experiencia inolvidable!</i></b></li>
          </ul>
        </div>

            <!-- Imagen estática a la derecha -->
            <div class="image" style="margin-top: 10px;">
              <img 
                src="/images/deu4.png" 
                alt="Imagen Curso Alemán Alemania" 
                style="box-shadow: 0 6px 12px rgba(0, 0, 0, 0.92);"
                class="rounded-lg">
            </div>
          </div>
        </div>

    <!-- Sección de Información sobre Curso Junio 2025 -->
    <div class="container" style="margin-top: 60px; padding-top: 40px; border-top: 2px solid #ccc;" id="FraJune">
      <div class="items-center gap-8 md:grid md:grid-cols-2">
        <!-- Imagen a la izquierda -->
        <div class="image" style="margin-top: 10px;">
          <img 
            src="/images/cursoita.png" 
            alt="Imagen Contacto Curso Alemán Extranjero Junio" 
            style="box-shadow: 0 6px 12px rgba(0, 0, 0, 0.92); width: 500px; height: 400px;" 
            class="rounded-lg">
        </div>

        <!-- Contenido de texto a la derecha -->
        <div class="content">
          <h3 class="title-hover" style="text-align: center;">
            <b>Curso de verano en Alemania para jóvenes y adultos</b>
          </h3>
          <h2 class="title-hover" style="text-align: center;">Junio 2025</h2>
          <ul style="list-style: none; padding: 0; font-size: 1.3em; text-align: justify;">
            <p style="text-align: justify; font-size: 1.2em;"><b>Contenido del curso:</b></p>
            <li>Aprende y disfruta durante el mes de junio.</li>
            <li><span style="color: #0AA8A7; "><b>Inicia: junio 02</b></span></li>
            <li><span style="color: #0AA8A7; "><b>Fin: junio 30</b></span></li>
            <li>Curso de 80 horas</li>
            <li>Escuela de prestigio y reconocida experiencia</li>
            <li>Visitas de fin de semana</li>
            <p style="text-align: justify; font-size: 1.2em;"><b>Al finalizar el curso:</b></p>
            <li>Recorrido cultural de 15 días (Países Bajos, Bélgica, París y alrededores)</li>
            <li><span style="color: #0AA8A7; "><b>Salida: 29 de mayo</b></span></li>
            <li><span style="color: #0AA8A7; "><b>Regreso: 15 de julio</b></span></li>
          </ul>
        </div>
      </div>
    </div>
    
<!-- Sección de Información sobre Curso Julio 2025 -->
<div class="container" style="margin-top: 60px; padding-top: 40px; border-top: 2px solid #ccc;" id="FraJuly">
  <div class="items-center gap-8 md:grid md:grid-cols-2">
    
    <!-- Contenido de texto a la izquierda -->
    <div class="content">
      <h3 class="title-hover" style="text-align: center;">
        <b>Curso de verano en Alemania para jóvenes y adultos</b>
      </h3>
      <h2 class="title-hover" style="text-align: center;">Julio 2025</h2>
      <ul style="list-style: none; padding: 0; font-size: 1.3em; text-align: justify;">
        <p style="text-align: justify; font-size: 1.2em;"><b>Contenido del curso:</b></p>
        <li>Disfruta y aprende durante el mes de julio.</li>
        <li><span style="color: #0AA8A7; "><b>Inicia: julio 03</b></span></li>
        <li><span style="color: #0AA8A7; "><b>Fin: julio 30</b></span></li>
        <li>Curso de 80 horas</li>
        <li>Escuela de prestigio y reconocida experiencia</li>
        <li>Visitas de fin de semana</li>
        <p style="text-align: justify; font-size: 1.2em;"><b>Al finalizar el curso:</b></p>
        <li>Recorrido cultural de 15 días (Países Bajos, Bélgica, París y alrededores)</li>
        <li><span style="color: #0AA8A7; "><b>Salida: 30 de junio</b></span></li>
        <li><span style="color: #0AA8A7; "><b>Regreso: 14 de agosto</b></span></li>
      </ul>
    </div>

    <!-- Imagen a la derecha -->
    <div class="image" style="margin-top: 10px;">
      <img 
        src="/images/cursoita.png" 
        alt="Imagen Contacto Curso Alemán Extranjero Julio" 
        style="box-shadow: 0 6px 12px rgba(0, 0, 0, 0.92); width: 500px; height: 400px;" 
        class="rounded-lg">
    </div>
  </div>
</div>

<!-- Sección de Información sobre Curso Agosto 2025 -->
<div class="container" style="margin-top: 60px; padding-top: 40px; border-top: 2px solid #ccc;" id="FraAug">
  <div class="items-center gap-8 md:grid md:grid-cols-2">
    <!-- Imagen a la izquierda -->
    <div class="image" style="margin-top: 10px;">
      <img 
        src="/images/cursoita.png" 
        alt="Imagen Contacto Curso Alemán Extranjero Agosto" 
        style="box-shadow: 0 6px 12px rgba(0, 0, 0, 0.92); width: 500px; height: 400px;" 
        class="rounded-lg">
    </div>
    <!-- Contenido de texto a la derecha -->
    <div class="content">
      <h3 class="title-hover" style="text-align: center;">
        <b>Curso de verano en Alemania para jóvenes y adultos</b>
      </h3>
      <h2 class="title-hover" style="text-align: center;">Agosto 2025</h2>
      <ul style="list-style: none; padding: 0; font-size: 1.3em; text-align: justify;">
        <p style="text-align: justify; font-size: 1.2em;"><b>Contenido del curso:</b></p>
        <li>Aprende y disfruta durante el mes de agosto.</li>
        <li><span style="color: #0AA8A7;"><b>Inicia: agosto 04</b></span></li>
        <li><span style="color: #0AA8A7;"><b>Fin: agosto 28</b></span></li>
        <li>Curso de 80 horas</li>
        <li>Escuela de prestigio y reconocida experiencia</li>
        <li>Visitas de fin de semana</li>
        <p style="text-align: justify; font-size: 1.2em;"><b>Al finalizar el curso:</b></p>
        <li>Recorrido cultural de 13 días (Países Bajos, Bélgica, París y alrededores)</li>
        <li><span style="color: #0AA8A7;"><b>Salida: 30 de julio</b></span></li>
        <li><span style="color: #0AA8A7;"><b>Regreso: 10 de septiembre</b></span></li>
      </ul>
    </div>
  </div>
</div>

   </section>

   <style>
    /*************************************************************/
    /* Animación de titulos */
    /*************************************************************/
    .title-hover {
          transition: transform 0.3s ease; /* Suaviza la transformación */
        }
        
        .title-hover:hover {
          transform: scale(1.1); /* Aumenta el tamaño al 110% */
        }
  
    /*************************************************************/
    /* Animación de imagenes */
    /*************************************************************/
        .image {
        transition: transform 0.3s ease; /* Suaviza la transformación */
      }
      
      .image:hover {
        transform: scale(1.02); /* Aumenta el tamaño al 110% al pasar el mouse */
      }
    </style>
  
</Base>
